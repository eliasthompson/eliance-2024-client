{
  "include": ["config/**/*", "src/**/*"],
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2023"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@config": ["./config"],
      "@config/*": ["./config/*"],
      "@lib/*": ["./src/lib/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@src": ["./src"],
      "@src/*": ["./src/*"]
    },
    "strict": true,
    "target": "ES2023",
    "types": ["obs-studio"]
  }
}
