# Copy to .env to tell the obs-layout-firebot tools (npm run obs:* and firebot:*) where Firebot and OBS are on this
# machine, when the defaults do not fit. Every line is optional. Unset, the tools use Firebot's own OBS integration
# settings for the websocket, the "Main" profile under Firebot's data folder, and the scene collection OBS reports.
#FIREBOT_PROFILE_DIR=
#FIREBOT_API_URL=http://localhost:7472/api/v1
#OBS_SCENE_COLLECTION=
#OBS_WEBSOCKET_URL=ws://localhost:4455
#OBS_WEBSOCKET_PASSWORD=
